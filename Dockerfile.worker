FROM python:3.11-slim-bookworm

ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/app

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends curl ffmpeg git \
    && rm -rf /var/lib/apt/lists/*

# Install torch CPU first (separate layer for caching)
RUN pip install --no-cache-dir torch torchaudio --index-url https://download.pytorch.org/whl/cpu

# Install worker + training dependencies
COPY requirements/base.txt requirements/worker.txt training/requirements.txt ./requirements/
RUN pip install --no-cache-dir -r requirements/worker.txt \
    && pip install --no-cache-dir transformers>=4.39 datasets>=2.18 accelerate>=0.28 \
       evaluate>=0.4 jiwer>=3.0 soundfile>=0.12 librosa>=0.10 \
       ctranslate2>=4.0 huggingface-hub>=0.21 torchcodec

COPY app/ ./app/
COPY training/ ./training/

CMD ["celery", "-A", "app.worker.celery_app", "worker", "--loglevel=info", "--concurrency=1", "--pool=solo"]
