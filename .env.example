# ── PostgreSQL ──────────────────────────────────
POSTGRES_DB=transcriber
POSTGRES_USER=transcriber
POSTGRES_PASSWORD=CHANGE_ME_pg_secret

# ── MinIO ───────────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=CHANGE_ME_minio_secret

# ── PayFast ─────────────────────────────────────
PAYFAST_MERCHANT_ID=10000100
PAYFAST_PASSPHRASE=CHANGE_ME_payfast_passphrase

# ── Whisper Model ───────────────────────────────
# Path on the HOST where the faster-whisper model is stored
# Download with: huggingface-cli download Systran/faster-whisper-large-v3 --local-dir /opt/models/faster-whisper-large-v3
HOST_MODEL_PATH=/opt/models/faster-whisper-large-v3

# Device: "cpu" or "cuda" (cuda requires NVIDIA GPU + Container Toolkit)
WHISPER_DEVICE=cpu
# Compute type: "int8" for CPU, "float16" for GPU
WHISPER_COMPUTE_TYPE=int8

# ── n8n Webhook ─────────────────────────────────
N8N_WEBHOOK_URL=http://n8n:5678/webhook/transcription-complete

# ── Caddy ───────────────────────────────────────
DOMAIN=transcribe.example.com

# ── Fine-Tuning (training only) ─────────────────
# HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxx
# WHISPER_MODEL=openai/whisper-small
# TORCH_INDEX_URL=https://download.pytorch.org/whl/cpu
# NUM_TRAIN_EPOCHS=3
# LEARNING_RATE=1e-5
# PER_DEVICE_TRAIN_BATCH_SIZE=4
